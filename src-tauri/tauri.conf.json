{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chudai Account Manager",
  "version": "0.9.9",
  "identifier": "com.chudai.accountmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run verify"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chudai Account Manager",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.rbxcdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Chudai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RUUzRTJCQTQxQzUwMUIKUldRYlVCeWtLejd1Skl5b1ZVcUtkSkhpQWl4SEtibVdRZUFESmo4U3hsTzAyQ29Ca3haZ1I4bkQK",
      "endpoints": [
        "https://github.com/Garskirtzz/Chudai-Account-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
